{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/login" },
    { "source": "/consulta-campo", "destination": "/index1" },
    { "source": "/resultado-conforme", "destination": "/index2" },
    { "source": "/resultado-infraccion", "destination": "/index3" },
    { "source": "/emision-acta", "destination": "/index4" },
    {
      "source": "/admin/configuracion",
      "destination": "/api/admin/configuracion"
    }
  ]
}
