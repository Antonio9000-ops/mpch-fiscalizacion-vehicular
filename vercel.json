{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/consulta-campo", "destination": "/index1.html" },
    { "source": "/resultado-conforme", "destination": "/index2.html" },
    { "source": "/resultado-infraccion", "destination": "/index3.html" },
    { "source": "/emision-acta", "destination": "/index4.html" },
    { "source": "/acta-exito", "destination": "/acta-exito.html" },
    { "source": "/fichas", "destination": "/fichas.html" },
    { "source": "/inscripcion", "destination": "/inscripcion.html" },
    { "source": "/chatbot", "destination": "/chatbot.html" },
    { "source": "/403", "destination": "/403.html" },
    {
      "source": "/admin/configuracion",
      "destination": "/api/admin/configuracion"
    }
  ]
}
